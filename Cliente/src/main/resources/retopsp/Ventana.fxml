<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="retopsp.cliente.PrimaryController" spacing="10" style="-fx-padding: 15;">
    <!-- Top Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="IP:"/>
        <TextField fx:id="txtIp" text="127.0.0.1" prefWidth="90"/>
        <Label text="Puerto:"/>
        <TextField fx:id="txtPuerto" text="5000" prefWidth="60"/>
        <Label text="Usuario:"/>
        <TextField fx:id="txtUsuario" promptText="Usuario" prefWidth="90"/>
        <Button fx:id="btnConectar" text="Conectar"/>
        <Button fx:id="btnDesconectar" text="Desconectar"/>
        <Label fx:id="lblEstado" text="No conectado" style="-fx-font-weight: bold;"/>
    </HBox>
    
    <!-- Chat Area with blue border as requested -->
    <TextArea fx:id="txtChat" VBox.vgrow="ALWAYS" editable="false" wrapText="true" style="-fx-border-color: #00A2E8; -fx-border-width: 1.5;"/>
    
    <!-- Bottom Bar with Checkbox -->
    <HBox spacing="10" alignment="CENTER_LEFT">
        <CheckBox fx:id="chkPrivado" text="Privado"/>
        <Label text="Para:"/>
        <TextField fx:id="txtDestinatario" prefWidth="100" promptText="admin"/>
        <TextField fx:id="txtMensaje" HBox.hgrow="ALWAYS" />
        <Button fx:id="btnEnviar" text="Enviar" defaultButton="true"/>
    </HBox>
</VBox>
